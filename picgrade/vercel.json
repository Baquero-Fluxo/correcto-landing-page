{
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/landing-page/(.*)$", "dest": "/public/landing-page/$1" },
    { "src": "^/landing-page$", "dest": "/public/landing-page/index.html" },
    { "src": "/$", "dest": "/public/index.html" },
    { "src": "^/public/(.*)$", "dest": "/public/$1" }
  ],
  "rewrites": [
    {
      "source": "/blog/:path*",
      "destination": "https://picgrade-content.vercel.app/blog/:path*"
    },
    {
      "source": "/blog",
      "destination": "https://picgrade-content.vercel.app/blog"
    }
  ]
}
