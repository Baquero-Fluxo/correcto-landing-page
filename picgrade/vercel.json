{
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://picgrade-content.vercel.app/blog/:path*"
    },
    {
      "source": "/blog",
      "destination": "https://picgrade-content.vercel.app/blog"
    }
  ]
}
